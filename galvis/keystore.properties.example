# Example keystore configuration for Google Play / Release signing.
# Copy this file to keystore.properties and fill in your actual credentials.
# NEVER commit keystore.properties or *.jks / *.keystore files to version control!

storeFile=../release-keys/galvis-release.keystore
storePassword=your_keystore_password
keyAlias=galvis-key
keyPassword=your_key_password
