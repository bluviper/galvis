<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV / CleanYourTV Floating Glass Highlight & Specular Sheen -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Layer 1: Contrast Drop Shadow Edge (Ensures crisp separation on 100% white banners like YouTube) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#00000000" />
                    <stroke android:width="4dp" android:color="#59000000" />
                </shape>
            </item>

            <!-- Layer 2: Luminous Ice-Blue Glowing Glass Bezel (CleanYourTV signature glass highlight) -->
            <item android:inset="0.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#00000000" />
                    <stroke android:width="3dp" android:color="#F080D8FF" />
                </shape>
            </item>

            <!-- Layer 3: Crisp Diamond-White Core Rim -->
            <item android:inset="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <solid android:color="#00000000" />
                    <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>

            <!-- Layer 4: Glossy Specular Glass Glare (Apple TV tvOS curved glass reflection sheen) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#47FFFFFF"
                        android:centerColor="#12FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:centerY="0.45"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
